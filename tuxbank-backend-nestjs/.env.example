# Variables de entorno del backend de Tux Bank.
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` esta ignorado por git: nunca subas credenciales al repositorio.

# Puerto HTTP del servidor NestJS
PORT=3000

# Cadena de conexion de MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<password>@<cluster>/<base-de-datos>?retryWrites=true&w=majority
# Las transacciones (withTransaction) requieren un replica set: un cluster de
# Atlas ya lo es, incluso en el plan gratuito M0.
MONGODB_URI=

# Secreto con el que se firman y verifican los JWT.
# Es obligatorio: si falta, la aplicacion no arranca (a proposito).
# Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Origen permitido por CORS (el dev server de Vite). Opcional, por defecto
# http://localhost:5173
CLIENT_URL=http://localhost:5173

# Entorno de ejecucion. En `production` la cookie se marca como `secure`
# y por lo tanto solo viaja por HTTPS.
NODE_ENV=development
